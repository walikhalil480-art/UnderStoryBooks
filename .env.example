# ==============================================================================
# eBaro Application Environment Configuration Template
# Copy this file to '.env' and populate with your production credentials.
# ==============================================================================

# Application & Network Ports
FRONTEND_PORT=8088
BACKEND_PORT=5000
NODE_ENV=production

# Database & Runtime
DATABASE_PATH=/app/server/data/folio.sqlite
MANUSCRIPTS_DIR=/app/server/storage/manuscripts

# Default Administrator Seed
ADMIN_EMAIL=admin@ebaro.org
ADMIN_PASSWORD=AdminPass2026!

# Payment Gateways Mode (true for sandbox simulation, false for production APIs)
SIFALO_SANDBOX=true
MPESA_SANDBOX=true

# Optional Commercial Payment Provider Secrets
SIFALO_API_KEY=
SIFALO_MERCHANT_ID=
SIFALO_WEBHOOK_SECRET=
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
MPESA_PASSKEY=
MPESA_SHORTCODE=
