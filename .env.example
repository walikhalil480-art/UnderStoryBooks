# ============================================================================
# UnderStoryBooks — Environment Configuration Template
# Copy this file to `.env` for local development or Docker Compose overrides.
# Never commit real production secrets or API keys to version control.
# ============================================================================

# --- Runtime & Server Configuration ---
NODE_ENV=development
HOST=0.0.0.0
PORT=5000
FRONTEND_PORT=8088
BACKEND_PORT=5000

# --- PostgreSQL Database Configuration (Docker / Kubernetes / Production) ---
DB_HOST=localhost
DB_PORT=5432
POSTGRES_DB=understory_db
POSTGRES_USER=understory_user
POSTGRES_PASSWORD=understory_secure_password_2026
POSTGRES_PORT=5432
DATABASE_URL=postgresql://understory_user:understory_secure_password_2026@localhost:5432/understory_db

# --- Default Administrator Bootstrap ---
# Used by server/db.ts when seeding the initial administrator account
ADMIN_DEFAULT_PASSWORD=ChangeMe_AdminPassword_2026!

# --- East African & Global Payment Gateways ---
# Keep SANDBOX=true for local development and automated verification suites.
# Set SANDBOX=false and provide live credentials only in production environments.

# Sifalo Pay (EVC Plus / Zaad / Sahal / eDahab aggregator)
SIFALO_SANDBOX=true
SIFALO_API_USER=your_sifalo_api_username_here
SIFALO_API_KEY=your_sifalo_api_key_here

# Safaricom M-Pesa Daraja 2.0 (STK Push)
MPESA_SANDBOX=true
MPESA_CONSUMER_KEY=your_mpesa_consumer_key_here
MPESA_CONSUMER_SECRET=your_mpesa_consumer_secret_here
MPESA_PASSKEY=your_mpesa_stk_passkey_here
MPESA_SHORTCODE=174379

# Webhook Signature Verification
PAYMENT_WEBHOOK_SECRET=your_webhook_hmac_secret_here
